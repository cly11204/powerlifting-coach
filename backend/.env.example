# Copy to .env and adjust. All values are optional.
DATABASE_URL=sqlite:///./powerlifting.db
# Comma-separated list of origins allowed to call the API (the Vite dev server by default)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Highest rep count used for e1RM estimates. Above this, estimates are too imprecise.
E1RM_MAX_REPS=10
